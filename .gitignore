.DS_Store
node_modules/
.env*
!.env.example
.next/
coverage/
*.tsbuildinfo
# packages/create's ephemeral compose output (npx-installer design spec §5) — generated by
# prepack, never committed. Scoped to packages/create/ specifically — a bare "templates/"
# pattern would also match docs/templates/, which IS tracked (it's part of the base compose
# copies itself).
packages/create/templates/
# tsup's bundled build output for the installer CLI — the only package with a build step.
packages/create/dist/
