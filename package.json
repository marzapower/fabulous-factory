{
  "name": "fabulous-factory-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter untangle dev",
    "dev:nothing": "pnpm --filter nothing dev",
    "dev:brainstorm": "pnpm --filter brainstorm dev",
    "build": "pnpm --filter untangle build",
    "lint": "eslint .",
    "boundaries": "depcruise apps packages --config .dependency-cruiser.cjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r run typecheck && tsc --noEmit -p benchmarks",
    "test": "vitest run",
    "check": "node scripts/check-node-version.mjs && pnpm lint && pnpm boundaries && pnpm format:check && pnpm typecheck && pnpm test",
    "factory:doctor": "tsx packages/config/scripts/doctor.ts",
    "factory:status": "tsx packages/config/scripts/factory-status.ts",
    "preflight": "tsx packages/config/scripts/preflight.ts",
    "gen": "tsx packages/config/scripts/gen.ts",
    "compose": "tsx packages/create/src/compose-build.ts",
    "db:migrate": "tsx packages/db/scripts/migrate.ts",
    "db:seed": "tsx packages/db/scripts/seed.ts",
    "db:generate": "pnpm --filter @factory/db exec drizzle-kit generate",
    "db:generate:untangle": "pnpm --filter @factory/untangle exec drizzle-kit generate",
    "db:generate:brainstorm": "pnpm --filter @factory/brainstorm exec drizzle-kit generate",
    "gen:env-example": "tsx packages/config/scripts/gen-env-example.ts",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "dependency-cruiser": "^18.2.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11"
  }
}
