{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // This package reads process.env indirectly via @factory/config only, but
    // src/email/daily-plan.tsx uses DOM-shaped JSX (html/body/ol) and @types/react's
    // ambient types reference lib.dom.d.ts; the root base config targets server code only
    // (lib: ["es2022"]), so DOM needs adding here (same pattern as packages/email).
    "types": ["node"],
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },
  "include": ["src", "test"]
}
