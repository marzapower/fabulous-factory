{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    // benchmarks/ isn't a pnpm workspace package (not listed in pnpm-workspace.yaml,
    // no package.json of its own) — it never gets its own `node_modules/@types` symlink
    // the way a real workspace package would from declaring "@types/node" as a
    // devDependency (see packages/core/tsconfig.json for that normal case). Point
    // typeRoots at pnpm's shared virtual-store @types directory instead, which is
    // populated as long as any workspace package depends on @types/node (several do).
    "typeRoots": ["../node_modules/.pnpm/node_modules/@types"],
    "types": ["node"],
    "noEmit": true
  },
  "include": ["**/*.ts"]
}
