# Refuse installs on a Node version outside the root package.json "engines" range (>=24).
engine-strict=true

# This is a pnpm workspace: the supply-chain release-age policy lives in
# pnpm-workspace.yaml (`minimumReleaseAge: 1440` — a deliberate 1-day floor, see the
# comment there for why a 7-day floor breaks day-one installs), not in this file. npm's
# own `min-release-age` key would be dead config here — pnpm never reads it.
# nosemgrep: package_managers.npm.npm-missing-minimum-release-age.npm-missing-minimum-release-age
